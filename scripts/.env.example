# Settings for the local admin scripts only. Copy to scripts/.env.
# NEVER put these in Vercel or commit the real file: the secret key bypasses
# Row Level Security.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# Accounts created by create_users.py
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
REVIEWER_1_EMAIL=reviewer1@example.com
REVIEWER_1_NAME=Reviewer 1
REVIEWER_2_EMAIL=reviewer2@example.com
REVIEWER_2_NAME=Reviewer 2
REVIEWER_3_EMAIL=reviewer3@example.com
REVIEWER_3_NAME=Reviewer 3
